# Existing app vars
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=MY_APP_URL

# Clerk auth (Phase 1)
# Do not wrap keys in quotes; quoted keys can fail runtime auth initialization.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_real_clerk_publishable_key
CLERK_PUBLISHABLE_KEY=replace_with_real_clerk_publishable_key
CLERK_SECRET_KEY=replace_with_real_clerk_secret_key
CLERK_WEBHOOK_SECRET=replace_with_real_clerk_webhook_secret

# Vercel project linkage (optional local use)
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=

# Phase 1 feature flags (true|false)
NEXT_PUBLIC_ENABLE_LEDGER=false
NEXT_PUBLIC_ENABLE_MCP=false
NEXT_PUBLIC_ENABLE_PICKUP=false
NEXT_PUBLIC_ENABLE_OFFLINE=false
NEXT_PUBLIC_ENABLE_CORE_VITE_MOUNT=false

# Phase 3 feature flags (true|false)
NEXT_PUBLIC_ENABLE_RUNTIME=false
NEXT_PUBLIC_ENABLE_DB_LEDGER=false
DB_LEDGER_PATH=
NEXT_PUBLIC_ENABLE_STANDARDS_VERIFIER=false

# Phase 4 hybrid engine env contract
# AWS_REGION: required for all AWS service calls (e.g., us-east-1)
AWS_REGION=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: static IAM key fallback.
# Prefer OIDC role assumption in Vercel + GitHub Actions over static keys.
# Rotate every 90 days — see docs/operations-runbook.md (AWS Credential Strategy).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# WARNING: Session tokens are temporary. Never set in Vercel production or long-lived secrets.
# AWS_SESSION_TOKEN is ONLY valid for local assumed-role sessions; it expires automatically.
AWS_SESSION_TOKEN=
AWS_SQS_QUEUE_URL=
AWS_SQS_DLQ_URL=
AWS_DYNAMODB_ORCHESTRATION_TABLE=
AWS_EVENTBRIDGE_BUS_NAME=
BEDROCK_MODEL_ID=amazon.titan-text-express-v1
# ALLOW_AWS_WORKER_FALLBACK: set true to fall back to in-memory queue when AWS credentials are unavailable.
ALLOW_AWS_WORKER_FALLBACK=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
FEDERATION_GATEWAY_SHARED_SECRET=
ROOTWORK_TELEMETRY_INGEST_TOKEN=
NEXT_PUBLIC_ENABLE_LOCAL_OLLAMA=false
NEXT_PUBLIC_ENABLE_FEDERATION=false

# Optional role E2E smoke vars
E2E_BASE_URL=http://127.0.0.1:3000
E2E_START_LOCAL_SERVER=false
E2E_VERCEL_PROTECTION_BYPASS_TOKEN=
E2E_STUDENT_INDEPENDENT_EMAIL=
E2E_STUDENT_INDEPENDENT_PASSWORD=
E2E_STUDENT_ENROLLED_EMAIL=
E2E_STUDENT_ENROLLED_PASSWORD=
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ADULT_LEARNER_EMAIL=
E2E_ADULT_LEARNER_PASSWORD=
E2E_PROFESSIONAL_DEVELOPMENT_EMAIL=
E2E_PROFESSIONAL_DEVELOPMENT_PASSWORD=

# Optional super-admin E2E smoke vars (verify:super-admin-e2e)
# Set to a Clerk user with publicMetadata.role = "super_admin"
# If unset, verify:super-admin-e2e skips gracefully (exit 0).
E2E_SUPER_ADMIN_EMAIL=
E2E_SUPER_ADMIN_PASSWORD=


MODEL_ROUTING_POLICY=local_first
AUDIT_LOG_TO_FILE=false
AUDIT_HTTP_ENDPOINT=
AUDIT_HTTP_BEARER_TOKEN=

