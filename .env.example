# Existing app vars
GEMINI_API_KEY=MY_GEMINI_API_KEY
# APP_URL: currently not referenced in application code; reserved for future use (e.g. email templates, CORS origin).
APP_URL=

# Clerk auth (Phase 1)
# Use pk_test_* / sk_test_* for development; use pk_live_* / sk_live_* for the production Clerk instance.
# Do not wrap keys in quotes; quoted keys can fail runtime auth initialization.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_real_clerk_publishable_key
CLERK_PUBLISHABLE_KEY=replace_with_real_clerk_publishable_key
CLERK_SECRET_KEY=replace_with_real_clerk_secret_key
CLERK_WEBHOOK_SECRET=replace_with_real_clerk_webhook_secret
# Clerk URL routing — must match the routes registered in middleware.ts.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Vercel project linkage (optional local use)
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
# Set automatically by the Vercel runtime; set manually for local testing (development|preview|production).
VERCEL_ENV=
# Set automatically by the Vercel runtime; used by verify:synthetic-smoke as the base URL fallback.
VERCEL_URL=

# Phase 1 feature flags (true|false)
# NEXT_PUBLIC_ENABLE_LEDGER: Enables mission/artifact recording to the ledger adapter
NEXT_PUBLIC_ENABLE_LEDGER=false
# NEXT_PUBLIC_ENABLE_MCP: Enables MCP protocol server endpoint
NEXT_PUBLIC_ENABLE_MCP=false
# NEXT_PUBLIC_ENABLE_PICKUP: Enables facilitator pickup-queue UI surface
NEXT_PUBLIC_ENABLE_PICKUP=false
# NEXT_PUBLIC_ENABLE_OFFLINE: Enables service-worker offline caching (see issue #172)
NEXT_PUBLIC_ENABLE_OFFLINE=false
# NEXT_PUBLIC_ENABLE_CORE_VITE_MOUNT: Legacy Vite bridge mount — keep false; deprecated
NEXT_PUBLIC_ENABLE_CORE_VITE_MOUNT=false

# Phase 3 feature flags (true|false)
# NEXT_PUBLIC_ENABLE_RUNTIME: Enables the runtime state engine (missions, artifacts, stage progression)
NEXT_PUBLIC_ENABLE_RUNTIME=false
# NEXT_PUBLIC_ENABLE_DB_LEDGER: Enables server-side DB ledger (SQLite local / DynamoDB on Vercel)
NEXT_PUBLIC_ENABLE_DB_LEDGER=false
# Override SQLite path; blank = default rootwork-ledger.db
DB_LEDGER_PATH=
# NEXT_PUBLIC_ENABLE_STANDARDS_VERIFIER: Enables the standards verification engine
NEXT_PUBLIC_ENABLE_STANDARDS_VERIFIER=false

# Phase 4 hybrid engine env contract
# AWS_REGION: required for all AWS service calls (e.g., us-east-1)
AWS_REGION=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: static IAM key fallback.
# Prefer OIDC role assumption in Vercel + GitHub Actions over static keys.
# Rotate every 90 days — see docs/operations-runbook.md (AWS Credential Strategy).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# WARNING: Session tokens are temporary. Never set in Vercel production or long-lived secrets.
# AWS_SESSION_TOKEN is ONLY valid for local assumed-role sessions; it expires automatically.
AWS_SESSION_TOKEN=
AWS_SQS_QUEUE_URL=
AWS_SQS_DLQ_URL=
AWS_DYNAMODB_ORCHESTRATION_TABLE=
# Dedicated DynamoDB table for the ledger adapter (DB_LEDGER_ADAPTER=dynamo).
# Falls back to AWS_DYNAMODB_ORCHESTRATION_TABLE with a "ledger#" key prefix if unset.
AWS_DYNAMODB_LEDGER_TABLE=
# Dedicated DynamoDB table for runtime state persistence (pk: runtime#<learnerId>, sk: state).
AWS_DYNAMODB_RUNTIME_TABLE=
# Dedicated DynamoDB table for licensing tenants and teacher assignments.
AWS_DYNAMODB_LICENSING_TABLE=
# Dedicated DynamoDB table for standards config (pk: standards, sk: config).
AWS_DYNAMODB_STANDARDS_TABLE=
AWS_EVENTBRIDGE_BUS_NAME=
BEDROCK_MODEL_ID=amazon.titan-text-express-v1
# ALLOW_AWS_WORKER_FALLBACK: set true to fall back to in-memory queue when AWS credentials are unavailable.
ALLOW_AWS_WORKER_FALLBACK=false
# DB_LEDGER_ADAPTER: selects the server-side ledger backend. Options: dynamo (Vercel/prod), sqlite (local dev).
# Omit or leave blank to use the in-memory/localStorage fallback.
DB_LEDGER_ADAPTER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Timeout in ms for Ollama inference requests (default 30s)
OLLAMA_TIMEOUT_MS=30000
FEDERATION_GATEWAY_SHARED_SECRET=
ROOTWORK_TELEMETRY_INGEST_TOKEN=
# NEXT_PUBLIC_ENABLE_LOCAL_OLLAMA: Enables local Ollama provider as a fallback to cloud inference
NEXT_PUBLIC_ENABLE_LOCAL_OLLAMA=false
# NEXT_PUBLIC_ENABLE_FEDERATION: Enables multi-agent task federation dispatch (/api/federation)
NEXT_PUBLIC_ENABLE_FEDERATION=false

# Smoke and CI control vars
# Override the base URL used by verify:synthetic-smoke (e.g. https://rwfw-los.vercel.app)
ROOTWORK_SYNTHETIC_BASE_URL=
# Set true to run verify:http-smoke even when CI=true (normally skipped to avoid Clerk JWKS startup hang)
FORCE_HTTP_SMOKE=false
# Set true to skip the SQLite ledger consistency check (required in CI where no DB file is present)
LEDGER_CONSISTENCY_ALLOW_SKIP=false

# Optional role E2E smoke vars
E2E_BASE_URL=http://127.0.0.1:3000
E2E_START_LOCAL_SERVER=false
E2E_VERCEL_PROTECTION_BYPASS_TOKEN=
E2E_STUDENT_INDEPENDENT_EMAIL=
E2E_STUDENT_INDEPENDENT_PASSWORD=
E2E_STUDENT_ENROLLED_EMAIL=
E2E_STUDENT_ENROLLED_PASSWORD=
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ADULT_LEARNER_EMAIL=
E2E_ADULT_LEARNER_PASSWORD=
E2E_PROFESSIONAL_DEVELOPMENT_EMAIL=
E2E_PROFESSIONAL_DEVELOPMENT_PASSWORD=

# Super-admin E2E smoke vars (verify:role-e2e)
# Set to a Clerk user with publicMetadata.role = "super_admin".
# REQUIRED for production readiness — provision after Clerk production instance is live (see issue #161).
E2E_SUPER_ADMIN_EMAIL=
E2E_SUPER_ADMIN_PASSWORD=

MODEL_ROUTING_POLICY=local_first

# Audit log configuration
# AUDIT_LOG_TO_FILE: set true to write NDJSON audit events to AUDIT_LOG_PATH (local dev only — skipped on Vercel/serverless).
AUDIT_LOG_TO_FILE=false
# AUDIT_LOG_PATH: optional absolute path for the audit NDJSON file.
# Defaults to docs/status/audit-log.ndjson (relative to CWD). Only used when AUDIT_LOG_TO_FILE=true.
AUDIT_LOG_PATH=
AUDIT_HTTP_ENDPOINT=
AUDIT_HTTP_BEARER_TOKEN=

# Rate limiting
# The default rate limiter (lib/ratelimit/index.ts) uses in-memory sliding windows.
# WARNING: In-memory state resets on Vercel cold starts and is NOT shared across instances.
# For production multi-instance deployments, replace with @upstash/ratelimit + Redis.
# RATELIMIT_REDIS_URL: set to an Upstash Redis REST URL to enable distributed rate limiting.
RATELIMIT_REDIS_URL=

# Error monitoring (optional — configure for production)
# NEXT_PUBLIC_SENTRY_DSN: Sentry project DSN for client+server error reporting
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Enterprise Swarm Orchestration — Governance & AI Integrity
# NEXT_PUBLIC_ENABLE_INFERENCE_AUDIT: enables AI prompt lineage hashing and model
# metadata recording via lib/llm/inferenceAudit.ts. Records model, provider, latency,
# and SHA-256(prompt) hash to the audit log and GET /api/governance/ai-audit.
NEXT_PUBLIC_ENABLE_INFERENCE_AUDIT=false
# AWS_DYNAMODB_GOVERNANCE_TABLE: optional dedicated DynamoDB table for governance
# signals (threat intel, operability snapshots). Falls back to in-memory store if unset.
AWS_DYNAMODB_GOVERNANCE_TABLE=
